<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup=false 的补充声明:明确禁止云备份与设备迁移 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
