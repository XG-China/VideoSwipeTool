# 复制为 keystore.properties 后填写真实值;该文件已被 .gitignore 排除,不要提交。
# storeFile 支持相对仓库根目录的路径,也可写绝对路径。
storeFile=release.jks
storePassword=change-me
keyAlias=autoskip
keyPassword=change-me

# 生成正式密钥(在仓库根目录执行):
#   keytool -genkeypair -v -keystore release.jks -alias autoskip \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# 注意:已经安装过 debug 版的设备,首次切换到正式签名必须卸载重装,
# 且会清空 App 设置。自用分发建议继续使用 debug 签名(不创建本文件即可)。
